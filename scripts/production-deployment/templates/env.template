# Supabase Production Environment Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

############
# SECRETS
# These must be set securely - use strong random values
############

# PostgreSQL Database Password (minimum 32 characters recommended)
POSTGRES_PASSWORD=your-super-secure-postgres-password-here

# JWT Secret for signing tokens (base64url encoded, 32+ characters)
JWT_SECRET=your-jwt-secret-here

# Anon Key - Public key for anonymous access (generate with JWT)
ANON_KEY=your-anon-key-here

# Service Role Key - Admin key with elevated privileges (keep SECRET!)
SERVICE_ROLE_KEY=your-service-role-key-here

# Dashboard credentials for Supabase Studio
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your-dashboard-password-here

############
# SITE CONFIGURATION
############

# Your public domain (e.g., api.example.com)
SITE_URL=https://your-domain.com

# API External URL (usually same as SITE_URL)
API_EXTERNAL_URL=https://your-domain.com

# Studio Default Project
STUDIO_DEFAULT_PROJECT=https://your-domain.com

# Studio Port (internal)
STUDIO_PORT=3000

# Kong API Gateway
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

############
# DATABASE CONFIGURATION
############

# PostgreSQL Configuration
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres

# Connection pooling (PgBouncer)
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_MIN_POOL_SIZE=10
PGBOUNCER_RESERVE_POOL_SIZE=5
PGBOUNCER_MAX_CLIENT_CONN=1000

############
# AUTHENTICATION (GoTrue)
############

# GoTrue API configuration
GOTRUE_SITE_URL=${SITE_URL}
GOTRUE_URI_ALLOW_LIST=*
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_RATE_LIMIT_EMAIL_SENT=30
GOTRUE_RATE_LIMIT_TOKEN_REFRESH=30

# JWT Configuration
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated

# Email Authentication
GOTRUE_MAILER_AUTOCONFIRM=false

# External OAuth Providers (optional - configure as needed)
# Google OAuth
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=

# GitHub OAuth
GOTRUE_EXTERNAL_GITHUB_ENABLED=false
GOTRUE_EXTERNAL_GITHUB_CLIENT_ID=
GOTRUE_EXTERNAL_GITHUB_SECRET=

############
# SMTP EMAIL CONFIGURATION
############

# SMTP Settings for sending emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_SENDER_NAME=Supabase

# Email templates
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

############
# STORAGE CONFIGURATION
############

# S3-compatible storage backend (optional)
# Leave empty to use local storage
STORAGE_BACKEND=file

# If using S3:
# STORAGE_BACKEND=s3
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=supabase-storage
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# STORAGE_S3_ENDPOINT=https://s3.amazonaws.com

# File size limits
STORAGE_FILE_SIZE_LIMIT=52428800  # 50MB

############
# REALTIME CONFIGURATION
############

# Realtime server settings
REALTIME_MAX_CONNECTIONS=100
REALTIME_IP_VERSION=ipv4

############
# API CONFIGURATION (PostgREST)
############

# PostgREST settings
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
PGRST_DB_MAX_ROWS=1000
PGRST_DB_POOL=10
PGRST_DB_POOL_TIMEOUT=10

############
# ANALYTICS (optional)
############

# Enable anonymous analytics
ENABLE_ANONYMOUS_TELEMETRY=false

############
# OBSERVABILITY
############

# Log level (debug, info, warning, error)
LOG_LEVEL=info

# Enable request logging
ENABLE_REQUEST_LOGS=true

############
# SECURITY
############

# CORS Configuration
CORS_ALLOWED_ORIGINS=*
# For production, specify exact origins:
# CORS_ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com

# API Rate Limiting
RATE_LIMIT_PER_HOUR=1000

############
# BACKUP CONFIGURATION
############

# Backup settings (used by backup scripts)
BACKUP_DIR=/var/backups/supabase
RETENTION_DAYS=7

# S3 backup destination (optional)
S3_BUCKET=
S3_ENDPOINT=

# Backup encryption key (recommended)
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key

############
# MONITORING
############

# Grafana admin password
GRAFANA_PASSWORD=your-grafana-password

############
# FEATURE FLAGS
############

# Enable/disable features
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

############
# ADVANCED CONFIGURATION
############

# Database connection string format
# postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Internal service URLs (usually don't need to change)
KONG_URL=http://kong:8000
GOTRUE_URL=http://auth:9999
REALTIME_URL=http://realtime:4000
REST_URL=http://rest:3000
STORAGE_URL=http://storage:5000
META_URL=http://meta:8080

############
# DOCKER CONFIGURATION
############

# Image tags (update these to pin specific versions)
POSTGRES_VERSION=15.1.0.147
KONG_VERSION=2.8.1
GOTRUE_VERSION=v2.99.0
POSTGREST_VERSION=v11.2.0
REALTIME_VERSION=v2.10.1
STORAGE_VERSION=v0.40.4
META_VERSION=v0.67.0
STUDIO_VERSION=20231123-bf5f6ed

############
# NOTES
############
# 1. Generate strong random values for all secrets
# 2. Keep service role key extremely secure - it has admin access
# 3. Use environment-specific values for production vs staging
# 4. Consider using a secrets manager (Vault, AWS Secrets Manager, etc.)
# 5. Regularly rotate passwords and keys
# 6. Monitor and audit API key usage
