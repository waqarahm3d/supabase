############
# DOMAINS
############
# Your API domain (without https://)
API_DOMAIN=db.qoqnuz.com
# Your Studio domain (without https://)
STUDIO_DOMAIN=studio.qoqnuz.com

############
# SECRETS
############
# IMPORTANT: Generate new secrets before deploying!
# Use: openssl rand -base64 32

# PostgreSQL password - CHANGE THIS!
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password-change-this

# JWT Secret - CHANGE THIS!
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Anonymous Key - Will be generated, don't change manually
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Service Role Key - Will be generated, don't change manually
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Kong expects these variable names (aliases for the above)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Dashboard credentials - CHANGE THESE!
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=your-dashboard-password-change-this

# Logflare API Key - CHANGE THIS!
LOGFLARE_API_KEY=your-super-secret-logflare-api-key-change-this

############
# DATABASE
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Database schemas exposed via PostgREST
PGRST_DB_SCHEMAS=public,storage,graphql_public

############
# API SETTINGS
############
# JWT expiry in seconds (default: 1 hour)
JWT_EXPIRY=3600

# Site URL - Your main application URL
SITE_URL=https://your-app.com

# Additional redirect URLs (comma separated)
ADDITIONAL_REDIRECT_URLS=

# Disable public signups
DISABLE_SIGNUP=false

############
# EMAIL
############
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@qoqnuz.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-password
SMTP_SENDER_NAME=Supabase

############
# PHONE
############
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

############
# STUDIO
############
STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project

############
# FUNCTIONS
############
FUNCTIONS_VERIFY_JWT=false

############
# KONG
############
# Kong is exposed on standard HTTP/HTTPS ports
# HTTP: port 80 (standard web traffic)
# HTTPS: port 443 (standard SSL traffic)
KONG_HTTP_PORT=80
KONG_HTTPS_PORT=443

############
# IMAGE PROXY
############
IMGPROXY_ENABLE_WEBP_DETECTION=true

############
# MISC
############
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
